# Sample configuration. For a quick setup, copy it and fill in the blanks:
#
#   cp .env.sample .env.local
#
# Real environment variables win over .env.local, which wins over .env.
# Commented-out lines show the defaults. A variable that is set but empty
# is an error, except for secrets, which then count as unset. Booleans
# accept true/false/1/0/yes/no/on/off. Durations combine the units d, h, m
# and s in this order, e.g. 90s, 1h30m or 7d.

# HTTP listen address.
#SITREP_LISTEN=:2607

# Database file. One instance per file.
#SITREP_DB=sitrep.db

# Base64-encoded 32-byte key for data source secrets. Generate with:
#   openssl rand -base64 32
#SITREP_SECRET_KEY=

# Default poll interval, 5s to 24h.
#SITREP_DEFAULT_REFRESH=30s

# Required. Comma-separated base domains, e.g. status.example.com, or
# sitrep.localhost for a local try: lowercase hostnames with at least two
# labels, each listed once.
SITREP_BASE_DOMAINS=

# Honor X-Forwarded-Host, X-Forwarded-Proto and X-Forwarded-For. Enable
# only behind a trusted proxy.
#SITREP_TRUST_PROXY=false

# Auth provider: oidc or basic. Only the variables of the selected provider
# are read.
#SITREP_AUTH=oidc

# Admin session lifetime, 5m to 30d.
#SITREP_SESSION_TTL=12h

# Single sign-on with OpenID Connect, for SITREP_AUTH=oidc.

# Required. Issuer URL, exactly as the identity provider reports it.
SITREP_OIDC_ISSUER=

# Required. Client ID.
SITREP_OIDC_CLIENT_ID=

# Client secret, for confidential clients.
#SITREP_OIDC_CLIENT_SECRET=

# Required. https://<base domain>/auth/oidc/callback, with one of
# SITREP_BASE_DOMAINS as host.
SITREP_OIDC_REDIRECT_URL=

# Space-separated scopes; openid is always requested.
#SITREP_OIDC_SCOPES="openid profile email"

# Claim with the user's groups: a list or a single string.
#SITREP_OIDC_GROUPS_CLAIM=groups

# Required. Group whose members may sign in.
SITREP_OIDC_ADMIN_GROUP=

# Username and password, for SITREP_AUTH=basic.

# Required. htpasswd-style users file, one username:hash per line, with
# bcrypt or argon2id hashes.
SITREP_BASIC_USERS_FILE=

# debug, info, warn or error.
#SITREP_LOG_LEVEL=info

# text, json or pretty (colored console output).
#SITREP_LOG_FORMAT=text
