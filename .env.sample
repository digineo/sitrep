# Sample configuration. For a quick setup, copy it and fill in the blanks:
#
#   cp .env.sample .env.local
#
# Real environment variables win over .env.local, which wins over .env.
# Commented-out lines show the defaults. A variable that is set but empty
# is an error, except for secrets, which then count as unset. Booleans
# accept true/false/1/0/yes/no/on/off. Durations combine the units d, h, m
# and s in this order, e.g. 90s, 1h30m or 7d.

# HTTP listen address.
#SITREP_LISTEN=:2607

# Database file. One instance per file.
#SITREP_DB=sitrep.db

# Base64-encoded 32-byte key for data source secrets. Generate with:
#   openssl rand -base64 32
#SITREP_SECRET_KEY=

# Default poll interval, 5s to 24h.
#SITREP_DEFAULT_REFRESH=30s

# Required. Comma-separated base domains, e.g. status.example.com, or
# sitrep.localhost for a local try: lowercase hostnames with at least two
# labels, each listed once.
SITREP_BASE_DOMAINS=

# Honor X-Forwarded-Host, X-Forwarded-Proto and X-Forwarded-For. Enable
# only behind a trusted proxy.
#SITREP_TRUST_PROXY=false

# Auth provider.
#SITREP_AUTH=oidc

# Admin session lifetime, 5m to 30d.
#SITREP_SESSION_TTL=12h

# debug, info, warn or error.
#SITREP_LOG_LEVEL=info

# text, json or pretty (colored console output).
#SITREP_LOG_FORMAT=text
